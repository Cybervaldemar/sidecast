[Unit]
Description=LANPlay screen streaming
After=network-online.target
Wants=network-online.target

[Service]
User=lanplay
Group=lanplay
StateDirectory=lanplay
ExecStart=/usr/local/bin/lanplay --listen :8080 --data /var/lib/lanplay --udp-ports 50000-50100
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/lanplay

[Install]
WantedBy=multi-user.target
